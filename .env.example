# ==============================================================================
# Lexora Intelligence Suite — Environment Configuration Template
# Copy this file to '.env' and provide your credentials where applicable.
# NOTE: Never commit your real '.env' file or production API keys to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Recommended)
# Powers:
#   - Writing Studio (Grammar, Rephrase, Fluency, Shorten, Simplify, Tone)
#   - Academic Refiner (Nature-standard unslop, citation & formula protection)
#   - Free Gemini Neural AI Text Detector (zero subscription cost)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Local Stylometrics Engine (Built-in & 100% Free)
# Automatically analyzes text burstiness, perplexity variance, and type-token ratio.
# No API key or internet access required.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. Optional Commercial Detection Providers
# If configured, Lexora includes them in cross-verification matrix calculations.
# If omitted, Lexora honestly marks them as "Unconfigured" without crashing.
# ------------------------------------------------------------------------------
# GPTZero API (https://gptzero.me/)
GPTZERO_API_KEY=your_gptzero_api_key_here

# Copyleaks API (https://copyleaks.com/)
COPYLEAKS_EMAIL=your_copyleaks_email_here
COPYLEAKS_API_KEY=your_copyleaks_api_key_here

# ------------------------------------------------------------------------------
# 4. Cloudflare Workers AI (Optional - Free Tier: 10,000 Neurons/day)
# Powers high-throughput open-weight models (@cf/meta/llama-3.3-70b-instruct,
# @cf/meta/llama-3.1-8b-instruct, @cf/qwen/qwen2.5-7b-instruct) for academic unslop,
# fact validation, and citation-protected text refinement.
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-70b-instruct
